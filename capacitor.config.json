{
  "appId": "ar.cygosc.cortescaba",
  "appName": "Cortes CABA",
  "webDir": "www",
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#1D5FBF"
    },
    "BackgroundRunner": {
      "label": "ar.cygosc.cortescaba.alertas",
      "src": "runners/alertas.js",
      "event": "revisarAlertas",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "force",
    "appendUserAgent": "CortesCABA/1.3 (+https://github.com/Cygosc/eventos-velez)"
  }
}
